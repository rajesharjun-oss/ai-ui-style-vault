{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ui-style-vault.local/research/business-profile.schema.json",
  "title": "Vault Business Understanding Profile",
  "type": "object",
  "required": ["status","officialName","businessCategory","offers","audiences","primaryConversion","evidenceSources","brandSignals","operationalFacts","researchGaps","confidence"],
  "properties": {
    "status": {"enum": ["ready","blocked","needs-owner-confirmation"]},
    "officialName": {"type": "string", "minLength": 2},
    "businessCategory": {"type": "string", "minLength": 2},
    "subcategories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "offers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name","evidenceStatus"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "evidenceStatus": {"enum": ["verified","provisional","owner-confirmed"]}}}},
    "audiences": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "primaryConversion": {"type": "object", "required": ["action","channel","evidenceStatus"], "properties": {"action": {"type": "string"}, "channel": {"type": "string"}, "evidenceStatus": {"enum": ["verified","provisional","owner-confirmed"]}}},
    "evidenceSources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type","reference","accessStatus"], "properties": {"type": {"type": "string"}, "reference": {"type": "string"}, "accessStatus": {"enum": ["inspected","user-supplied","blocked","partial"]}}},
    "brandSignals": {"type": "object", "required": ["positioning","visualSignals","tone"], "properties": {"positioning": {"type": "array", "items": {"type": "string"}}, "visualSignals": {"type": "array", "items": {"type": "string"}}, "tone": {"type": "array", "items": {"type": "string"}}}},
    "operationalFacts": {"type": "object", "additionalProperties": {"type": ["string","number","boolean","null"]}},
    "researchGaps": {"type": "array", "items": {"type": "string"}},
    "prohibitedAssumptions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "object", "required": ["score","rationale"], "properties": {"score": {"type": "integer", "minimum": 0, "maximum": 100}, "rationale": {"type": "string", "minLength": 10}}},
    "recommendedDomainPack": {"type": ["string","null"]},
    "designSelectionAllowed": {"type": "boolean"}
  }
}

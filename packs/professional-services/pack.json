{
  "id": "professional-services",
  "name": "Professional Services",
  "version": "1.0.0",
  "status": "production-guidance",
  "purpose": "Guide websites for accounting, audit, tax, legal, consulting, advisory, engineering, architecture and other expertise-led firms where trust, service fit, evidence and enquiry quality matter more than visual spectacle.",
  "requiredPrompt": "prompts/BUILD_PREMIUM_BUSINESS_WEBSITE.md",
  "extends": ["AGENTS.md","PRD.md","prompts/BUILD_PREMIUM_BUSINESS_WEBSITE.md","prompts/VISUAL_QA_AND_REVISION.md"],
  "productPrinciple": "Explain expertise, client fit, evidence and engagement path with restraint. A visitor should quickly understand what the firm solves, for whom, why it is credible and how to start an engagement.",
  "primaryJourneys": ["identify relevant service","understand client fit","evaluate credibility","inspect sector or case evidence","understand engagement process","contact or book a consultation"],
  "requiredPlanningArtifacts": ["BUSINESS_RESEARCH.md","business-profile.json","ASSET_PLAN.md","VAULT_SELECTION.md","BUILD_CONTRACT.md","CONTENT_PLAN.md","PROFESSIONAL_SERVICES_BUILD_CONTRACT.md","design-recipe.json"],
  "productionThemes": "packs/professional-services/production-themes.json",
  "pageBlueprints": "packs/professional-services/page-blueprints.json",
  "componentManifest": "packs/professional-services/component-manifest.json",
  "stateVocabulary": "packs/professional-services/state-vocabulary.json",
  "contentGuide": "packs/professional-services/content-and-trust.md",
  "assetGuide": "packs/professional-services/photography-and-proof-standard.md",
  "motionGuide": "packs/professional-services/motion-guidance.md",
  "accessibilityGuide": "packs/professional-services/accessibility-and-responsive.md",
  "implementationPrompt": "packs/professional-services/implementation-prompt.md",
  "templates": ["packs/professional-services/templates/PROFESSIONAL_SERVICES_BUILD_CONTRACT.md"],
  "requiredCapabilities": ["clear service taxonomy","client-fit language","credible proof and credentials","sector or problem pathways","specific enquiry action","accessible people/profile content","responsive long-form service pages","truthful claims and credentials","reduced-motion mode"],
  "rejectConditions": ["generic consulting slogans without service specificity","invented awards, clients, credentials or case results","stock imagery presented as staff or clients","unrelated luxury or 3D spectacle","all services reduced to identical cards","dense first viewport","contact CTA without context","motion that competes with trust or readability","another firm's site cloned"]
}
  "primaryJourneys": ["discover properties or developments","filter by relevant criteria","inspect media and specifications","understand location and amenities","evaluate availability and price status","book viewing or enquire"],
  "requiredPlanningArtifacts": ["BUSINESS_RESEARCH.md","business-profile.json","ASSET_PLAN.md","VAULT_SELECTION.md","BUILD_CONTRACT.md","CONTENT_PLAN.md","REAL_ESTATE_BUILD_CONTRACT.md","design-recipe.json"],
  "productionThemes": "packs/real-estate/production-themes.json",
  "pageBlueprints": "packs/real-estate/page-blueprints.json",
  "componentManifest": "packs/real-estate/component-manifest.json",
  "stateVocabulary": "packs/real-estate/state-vocabulary.json",

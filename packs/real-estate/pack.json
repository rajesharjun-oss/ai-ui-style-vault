  "assetGuide": "packs/real-estate/property-media-standard.md",
  "motionGuide": "packs/real-estate/motion-guidance.md",
  "accessibilityGuide": "packs/real-estate/accessibility-and-responsive.md",
  "implementationPrompt": "packs/real-estate/implementation-prompt.md",
  "templates": ["packs/real-estate/templates/REAL_ESTATE_BUILD_CONTRACT.md"],
  "requiredCapabilities": ["property/development taxonomy","location context","specification hierarchy","price-status disclosure","availability state","media provenance","viewing/enquiry flow","responsive gallery","map fallback","reduced motion","truthful render/photo distinction"],

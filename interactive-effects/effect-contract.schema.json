{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ui-style-vault.local/interactive-effects/effect-contract.schema.json",
  "title": "Vault Interactive Effect Contract",
  "type": "object",
  "required": ["id", "label", "family", "summary", "sections", "domains", "signals", "runtime", "tier", "assetMode", "mobile", "reducedMotion", "controls", "avoid"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "label": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "domains": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "runtime": {"enum": ["css", "dom-motion", "canvas-2d", "webgl", "three"]},
    "tier": {"enum": ["light", "balanced", "high"]},
    "assetMode": {"enum": ["none", "optional", "required"]},
    "mobile": {"type": "string", "minLength": 1},
    "reducedMotion": {"type": "string", "minLength": 1},
    "controls": {"type": "object"},
    "avoid": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}

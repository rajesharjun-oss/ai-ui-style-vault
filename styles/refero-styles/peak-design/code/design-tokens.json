{
  "name": "Peak Design",
  "version": "2026-07-28",
  "colors": {
    "carbonInk": {
      "value": "#1a211e",
      "role": "Primary text, dark hero panels, icons, and borders on light surfaces"
    },
    "paperWhite": {
      "value": "#ffffff",
      "role": "Canvas, commerce grids, and light sections"
    },
    "trueBlack": {
      "value": "#000000",
      "role": "Maximum contrast blocks and strokes"
    },
    "obsidian": {
      "value": "#0c0c0c",
      "role": "Deep editorial panels and overlays"
    },
    "fog": {
      "value": "#eef1f0",
      "role": "Input and subtle component backgrounds"
    },
    "mist": {
      "value": "#e0e0e0",
      "role": "Divider lines and structural separators"
    },
    "graphite": {
      "value": "#606562",
      "role": "Muted body text, metadata, and secondary navigation"
    },
    "ashBorder": {
      "value": "#cccfcd",
      "role": "Hairline borders and input edges"
    },
    "slate": {
      "value": "#363537",
      "role": "Navigation text and mid-weight borders"
    },
    "pewter": {
      "value": "#4e4e4e",
      "role": "Supporting neutral and badge fills"
    },
    "emberRed": {
      "value": "#cc2e39",
      "role": "Rare sale, urgency, or brand punctuation accent"
    }
  },
  "font": {
    "body": {
      "family": "Geist, Inter, Sohne, Helvetica Neue, system-ui, sans-serif",
      "weights": {
        "regular": 400,
        "semibold": 600,
        "bold": 700
      }
    },
    "display": {
      "family": "Exposure-style serif, Playfair Display, GT Super, Tiempos Headline, Georgia, serif",
      "weights": {
        "regular": 400
      }
    },
    "label": {
      "family": "Bryant-style condensed sans, Druk Wide, Inter Display Bold, Neue Haas Grotesk Display Bold, sans-serif",
      "weights": {
        "bold": 700
      },
      "textTransform": "uppercase"
    },
    "mono": {
      "family": "Geist Mono, JetBrains Mono, IBM Plex Mono, monospace",
      "weights": {
        "regular": 400
      }
    }
  },
  "typeScale": {
    "caption": {
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1,
      "letterSpacing": "0",
      "font": "body"
    },
    "buttonLabel": {
      "fontSize": "16px",
      "fontWeight": 700,
      "lineHeight": 1.1,
      "letterSpacing": "0.91px",
      "font": "label"
    },
    "headingSm": {
      "fontSize": "24px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "0.91px",
      "font": "label"
    },
    "heading": {
      "fontSize": "32px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "0",
      "font": "label"
    },
    "headingLg": {
      "fontSize": "48px",
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": "-1.2px",
      "font": "display"
    },
    "display": {
      "fontSize": "80px",
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": "-2px",
      "font": "display"
    }
  },
  "spacing": {
    "density": "comfortable",
    "unit": "4px",
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "32": "32px",
    "40": "40px",
    "48": "48px",
    "64": "64px",
    "maxWidth": "1440px",
    "sectionGap": "80px",
    "cardPadding": "24px",
    "elementGap": "24px"
  },
  "radius": {
    "nav": "4px",
    "inputs": "4px",
    "buttons": "4px",
    "cards": "8px",
    "images": "8px",
    "roundedButtons": "32px",
    "badges": "9999px",
    "filterPills": "9999px"
  },
  "elevation": {
    "rule": "No shadows or elevation effects.",
    "separation": ["flat color contrast", "1px hairline borders", "generous whitespace"]
  },
  "imagery": {
    "primary": "Studio-grade product photography",
    "hero": "Full-bleed product or lifestyle image in split panels",
    "productCard": "1:1 image with 8px radius",
    "avoid": ["illustrations", "abstract graphics", "3D renders", "decorative icon art", "gradient overlays"]
  }
}


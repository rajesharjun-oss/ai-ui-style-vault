      },
      "body": {
        "family": "madefor-text",
        "fallback": "Inter",
        "weights": [400]
      },
      "utility": {
        "family": "Arial",
        "fallback": "system-ui",
        "weights": [400]
      }
    },
    "typography": {
      "caption": {
        "fontSize": "13px",

      "slateMist": {
        "value": "#f1f5f9",
        "role": "Elevated surfaces, inputs, subtle panels"
      },
      "carbonInk": {
        "value": "#000000",
        "role": "Primary text, icon strokes, borders, black buttons"
      },
      "graphite": {
        "value": "#1c1d21",
        "role": "Slightly softened display headline text"
      },
      "ashBorder": {
        "value": "#d0d0d0",
        "role": "Hairline dividers and card borders"
      },
      "fogBorder": {
        "value": "#e8e6e6",
        "role": "Subtle borders on quieter elements"
      },
      "electricBlue": {
        "value": "#166aea",
        "role": "Primary action button fill and selected indicator"
      },
      "deepViolet": {
        "value": "#101585",
        "role": "Brand heading, link underline, decorative accent"
      },
      "indigoPulse": {
        "value": "#2c34af",
        "role": "Gradient endpoint and section heading accent"
      },
      "limeHighlight": {
        "value": "#dff994",
        "role": "Surface wash and decorative highlight zones"
      },
      "lemonNote": {
        "value": "#fdf4a1",

      "scale": {
        "4": "4px",
        "8": "8px",
        "12": "12px",
        "16": "16px",
        "20": "20px",
        "24": "24px",
        "36": "36px",
        "40": "40px",
        "44": "44px",
        "48": "48px",
        "52": "52px",
        "68": "68px",
        "84": "84px",
        "144": "144px"

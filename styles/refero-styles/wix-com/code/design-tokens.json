  },
  "components": {
    "primaryActionButton": {
      "background": "#166aea",
      "text": "#ffffff",
      "radius": "50px",
      "font": "madefor-text 16px",
      "use": "one per section maximum"
    },
    "secondaryActionButton": {
      "background": "#000000",
      "text": "#ffffff",
      "radius": "50px",
      "font": "madefor-text 16px"
    },
    "ghostButton": {
      "background": "transparent",
      "border": "1px solid contextual color",
      "radius": "50px",
      "font": "madefor-text 15px-16px"
    },
    "templatePreviewCard": {
      "radius": "20px",
      "innerImageRadius": "8.9px",
      "shadow": "minimal",
      "layout": "image dominant with label below"
    },
    "productMockupCard": {
      "radius": "8.9px",
      "border": "subtle or none",
      "content": "browser/editor/product UI screenshot"
    },
    "inputField": {
      "background": "#ffffff or #f1f5f9",
      "focusBorder": "#538ab6",
      "radius": "8px-12px",
      "font": "madefor-text 15px-16px"
    },
    "gradientSectionBackground": {
      "background": "linear-gradient from #bfc8e8 to #ffffff",
      "role": "section rhythm"
    }
  }
}

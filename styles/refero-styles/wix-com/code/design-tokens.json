      "lavenderMist": {
        "value": "#bfc8e8",
        "role": "Section gradient start and atmospheric wash"
      },
      "inputBlue": {
        "value": "#538ab6",
        "role": "Input focus and active border"
      }
    },
    "font": {
      "display": {
        "family": "madefor-display",

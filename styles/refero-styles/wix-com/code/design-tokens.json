        "letterSpacing": "-0.62px"
      },
      "heading": {
        "fontSize": "48px",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "-0.96px"
      },
      "headingLarge": {
        "fontSize": "82px",
        "fontWeight": 400,
        "lineHeight": 1,
        "letterSpacing": "-2.46px"
      },
      "display": {
        "fontSize": "104px",
        "fontWeight": 400,
        "lineHeight": 0.95,
        "letterSpacing": "-3.12px"
      }

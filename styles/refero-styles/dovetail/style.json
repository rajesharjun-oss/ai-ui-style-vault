  "referenceSite": "https://dovetail.com",
  "capturedAt": "2026-07-28",
  "industry": "research / customer insights",
  "mood": "dark research command center",
  "summary": "A dark research workspace style with graphite canvas, stepped charcoal cards, compact Inter text, JetBrains Mono metadata labels, thin borders, tag pills, evidence cards, transcript panels, and a single soft indigo accent.",
  "useWhen": [
    "Research repositories",
    "Customer insights tools",
    "AI analysis workspaces",
    "Video evidence dashboards",
    "Operations command centers",
    "Dark analytics products"
  ],
  "avoidWhen": [
    "Bright marketing landing pages",
    "Playful consumer apps",
    "Warm travel or hospitality sites",
    "Illustration-heavy campaigns",
    "Interfaces that need many accent colors"
  ],
  "colors": {
    "graphite": {
      "value": "#0a0a0a",
      "role": "Page canvas and deepest application background"
    },
    "obsidian": {
      "value": "#111111",
      "role": "Main cards, elevated surfaces, input backgrounds"
    },
    "charcoal": {
      "value": "#1e1e1e",
      "role": "Nested panels, hover states, secondary fills"
    },
    "slate": {
      "value": "#2d2d2d",
      "role": "Active rows, separators, toolbar surfaces"
    },
    "iron": {
      "value": "#3a3a3a",
      "role": "Stronger borders and disabled controls"
    },
    "silver": {
      "value": "#a3a3a3",
      "role": "Secondary text, metadata, muted descriptions"
    },
    "pearl": {
      "value": "#fafafa",
      "role": "Primary text and high-contrast icon strokes"
    },
    "white": {
      "value": "#ffffff",
      "role": "Strongest foreground, logos, selected icon details"
    },
    "softIndigo": {
      "value": "#8b7cf6",
      "role": "Primary CTA, selected states, active markers"
    },
    "indigoGlow": {
      "value": "#a78bfa",
      "role": "Hover/active accent and subtle glow detail"
    },
    "mutedPurple": {
      "value": "#6d5dd3",
      "role": "Secondary accent for tags, charts, inactive accent states"
    }
  },
  "typography": {

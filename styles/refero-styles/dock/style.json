  "useWhen": [
    "Customer workspace products",
    "Client portals",
    "Sales enablement tools",
    "Document collaboration",
    "Knowledge hubs",
    "Polished B2B SaaS pages"
  ],
  "avoidWhen": [
    "Dark developer tools",

    },
    "paperCream": {
      "value": "#fcf8ed",
      "role": "Page-level canvas"
    },
    "ivoryCard": {
      "value": "#fffdf8",
      "role": "Cards, product mockup frames, content panels"
    },
    "hairlineBeige": {
      "value": "#e8dcc8",

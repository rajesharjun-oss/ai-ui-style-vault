    "softTan": {
      "value": "#c9bda6",
      "role": "Tertiary labels, placeholder text, quiet metadata"
    },
    "electricCobalt": {
      "value": "#385bff",
      "role": "Primary CTA, active links, focus rings, selected states"
    },
    "cobaltHover": {
      "value": "#2748e8",
      "role": "Hover and active state for cobalt actions"
    },
    "darkCobalt": {
      "value": "#1530b8",
      "role": "Deep blue state and high-contrast active detail"
    },
    "paleBlue": {
      "value": "#eef2ff",
      "role": "Blue-tinted hover background and subtle active surface"
    },
    "morningMist": {
      "value": "#f6f0e4",
      "role": "Alternate cream section bands and nested panels"
    },
    "pureWhite": {
      "value": "#ffffff",
      "role": "Button text on cobalt and screenshot interiors"
    }
  },
  "typography": {

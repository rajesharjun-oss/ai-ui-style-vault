  "guidance": {
    "do": [
      "Use Linen Canvas as the root background.",
      "Use Paper White only for cards, inputs, and outlined buttons.",
      "Use 16px radius for containers, buttons, inputs, and video surfaces.",
      "Use 12px radius for small image tiles.",
      "Set display type at weight 350 with tight tracking.",
      "Pair filled and outlined buttons with identical sizing.",
      "Let user imagery carry all chromatic color.",
      "Use a single floating pill nav."
    ],
    "dont": [
      "Do not add accent colors to the interface chrome.",
      "Do not use font weights above 500.",
      "Do not add drop shadows to normal cards, buttons, or nav.",
      "Do not set body text outside the 14px to 18px range.",
      "Do not mix unrelated radius values into the page.",
      "Do not use pure black.",
      "Do not place colored UI backgrounds behind text.",
      "Do not build dashboards or data-dense layouts in this style."
    ]
  }
}


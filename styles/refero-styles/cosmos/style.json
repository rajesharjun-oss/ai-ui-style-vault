    },
    "inkBlack": {
      "value": "#0d0d0d",
      "token": "--color-ink-black",
      "role": "Primary text, icons, filled buttons, and low-opacity structural borders."
    },
    "paperWhite": {
      "value": "#ffffff",
      "token": "--color-paper-white",
      "role": "Cards, inputs, outlined buttons, and subtle elevated surfaces."
    },
    "stone": {
      "value": "#6e6a69",
      "token": "--color-stone",
      "role": "Body copy, secondary icons, inactive controls, and metadata."
    },
    "pebble": {
      "value": "#9a9796",
      "token": "--color-pebble",
      "role": "Helper text, tertiary labels, disabled text, and placeholder tone."
    }
  },

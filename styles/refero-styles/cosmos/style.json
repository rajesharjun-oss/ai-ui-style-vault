  "components": [
    "Primary Filled Button",
    "Secondary Outlined Button",
    "Pill Navigation Bar",
    "Search Input",
    "Floating Image Tile",
    "Feature Image Card",
    "Video Container",
    "AI Content Detection Overlay",
    "Text Link With Play Icon",
    "Theme Toggle",
    "Eyebrow Label",
    "Dot Cluster Logo"

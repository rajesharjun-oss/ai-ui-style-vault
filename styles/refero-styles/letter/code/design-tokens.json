{
  "name": "Letter",
  "slug": "letter",
  "source": {
    "provider": "refero",
    "url": "https://styles.refero.design/style/bcfc6cb0-1b39-4f3f-a95e-bd7b563b0efc",
    "referenceUrl": "https://letter.co",
    "capturedAt": "2026-07-28"
  },
  "theme": "mixed",
  "color": {
    "vaultInk": { "value": "#191b1f", "role": "dark hero and nav surface" },
    "paperWhite": { "value": "#ffffff", "role": "main canvas and inverse text" },
    "mistWhite": { "value": "#f6f9f9", "role": "soft section background" },
    "fogGray": { "value": "#9fabad", "role": "muted helper text" },
    "hairline": { "value": "#e6ebec", "role": "dividers and low-contrast strokes" },
    "obsidian": { "value": "#000000", "role": "maximum contrast ink" },
    "peachWall": { "value": "#fcede1", "role": "warm tinted product panel" },
    "mintWall": { "value": "#eefcef", "role": "cool tinted product panel" },
    "lavenderWall": { "value": "#e6def0", "role": "violet tinted product panel" },
    "deepTeal": { "value": "#186f64", "role": "primary action" },
    "electricViolet": { "value": "#536eff", "role": "secondary action" },
    "royalViolet": { "value": "#644bc4", "role": "deep violet state" },
    "sapphireBlue": { "value": "#154ea5", "role": "tertiary action" }
  },
  "typography": {
    "fontFamilies": {
      "neufileGroteskExtended": "\"Neufile Grotesk Extended\", Sohne, Inter, \"IBM Plex Sans\", system-ui, sans-serif",
      "albraSans": "\"Albra Sans\", \"GT Sectra\", \"Tiempos Headline\", Canela, \"Playfair Display\", Georgia, serif"
    },
    "scale": {
      "caption": { "size": "13px", "weight": 400, "lineHeight": 1.4, "letterSpacing": "0" },
      "body": { "size": "16px", "weight": 400, "lineHeight": 1.4, "letterSpacing": "0" },
      "subheading": { "size": "22px", "weight": 600, "lineHeight": 1.2, "letterSpacing": "0.44px" },
      "headingSm": { "size": "28px", "weight": 500, "lineHeight": 1.3, "letterSpacing": "0" },
      "heading": { "size": "46px", "weight": 600, "lineHeight": 1.2, "letterSpacing": "0.92px" },
      "display": { "size": "80px", "weight": 600, "lineHeight": 1.1, "letterSpacing": "1.6px" }
    }
  },
  "spacing": {
    "baseUnit": "4px",
    "scale": {
      "8": "8px",
      "12": "12px",
      "16": "16px",
      "24": "24px",
      "32": "32px",
      "48": "48px",
      "64": "64px",
      "72": "72px"
    },
    "layout": {
      "maxWidth": "1200px",
      "sectionGap": "64-96px",
      "cardPadding": "32px",
      "elementGap": "16px",
      "buttonPadding": "12px 27px"
    }
  },
  "radius": {
    "cards": "0px",
    "tags": "2px",
    "inputs": "2px",
    "buttons": "2px"
  },
  "surfaces": {
    "vaultInk": "#191b1f",
    "paperWhite": "#ffffff",
    "mistWhite": "#f6f9f9",
    "peachWall": "#fcede1",
    "mintWall": "#eefcef",
    "lavenderWall": "#e6def0"
  },
  "components": {
    "darkHeroStage": {
      "background": "{color.vaultInk.value}",
      "headline": "80px serif display",
      "visual": "large unmasked metallic 3D render"
    },
    "filledButton": {
      "radius": "2px",
      "padding": "12px 27px",
      "font": "{typography.fontFamilies.neufileGroteskExtended}",
      "shadow": "none"
    },
    "tintedFeatureCard": {
      "radius": "0px",
      "padding": "32px",
      "shadow": "none",
      "backgroundOptions": ["#fcede1", "#eefcef", "#e6def0"]
    },
    "ghostTextLink": {
      "background": "transparent",
      "border": "none",
      "colorRule": "match adjacent filled button"
    },
    "splitContentSection": {
      "maxWidth": "1200px",
      "columns": "50/50",
      "textSide": "left",
      "visualSide": "right"
    }
  }
}


  "theme": {
    "mode": "light",
    "summary": "Soft consumer wallet with rounded utility, tiny rainbow sparks, and confident black actions.",
    "principles": [
      "Keep the base interface neutral and very light.",
      "Use black for the most important action.",
      "Use rainbow colors only as localized accents.",
      "Use rounded cards and pill controls to keep the product friendly.",
      "Keep wallet data compact and scannable."
    ]
  },

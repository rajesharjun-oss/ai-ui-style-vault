      "padding": "10px 16px",
      "font": "14px Inter 600"
    },
    "walletBalanceCard": {
      "background": "#ffffff",
      "border": "1px solid rgba(0,0,0,0.06)",
      "radius": "20px",
      "padding": "24px",
      "shadow": "0 4px 16px rgba(15,23,42,0.06)",
      "balanceText": "32px Inter 700 #111111"
    },
    "tokenRow": {
      "background": "transparent or white",
      "height": "56px to 64px",
      "icon": "36px to 40px circle with token color or image",
      "name": "14px to 16px Inter 600",
      "meta": "13px to 14px muted gray",
      "change": "green for positive, red only for negative"
    },
    "pastelBadge": {
      "background": "light tint from accent color",
      "color": "darker matching accent or black",
      "radius": "9999px",
      "padding": "4px 10px",
      "font": "12px Inter 600"
    },
    "appStoreButton": {
      "background": "#111111 or #ffffff",
      "color": "white on black, black on white",
      "radius": "14px",
      "padding": "10px 16px",
      "border": "white variant uses soft border"
    },
    "roundedInput": {
      "background": "#ffffff",
      "color": "#111111",
      "placeholder": "#9ca3af",
      "border": "1px solid rgba(0,0,0,0.06)",
      "radius": "12px",
      "padding": "12px 14px"
    },
    "segmentedTabs": {
      "container": "#f7f8fa, 9999px radius, 4px padding",
      "activeTab": "white or black depending on context",
      "inactiveText": "#6b7280",
      "font": "13px Inter 600"
    },
    "onboardingPanel": {
      "background": "#ffffff",
      "radius": "20px",
      "padding": "24px",
      "content": "friendly heading, short copy, token/app icons, black CTA",
      "accent": "one small gradient or pastel badge"
    }
  },
  "layout": {
    "patterns": [
      "Hero with large friendly headline, black CTA, app-store buttons, and phone mockup",
      "Wallet balance card with token list below",
      "Token rows grouped into rounded white panels",
      "Feature cards with tiny pastel badges and app icons",
      "Onboarding checklist with a single black action",
      "Segmented tabs for wallet sections like tokens, NFTs, and activity"
    ],
    "imagery": "Phone screenshots, app mockups, wallet cards, token icons, NFT previews, and tiny app illustrations"
  },
  "motion": {
    "duration": "150ms to 250ms",
    "easing": "ease",
    "usage": "Small press/hover feedback and gentle mobile-app-like interactions"
  },
  "do": [
    "Use near-white backgrounds and white cards.",
    "Use black for the main filled CTA.",
    "Use Inter for the entire interface.",
    "Keep wallet data compact and easy to scan.",
    "Use 20px card radius and 12px control radius.",
    "Use 9999px pills for badges, filters, and token chips.",
    "Use rainbow color only in tiny accent moments.",
    "Make touch targets at least 40px high."
  ],
  "dont": [
    "Do not turn the entire interface into a rainbow gradient.",
    "Do not use multiple filled CTA colors.",
    "Do not use harsh black borders around every card.",
    "Do not add heavy shadows or glassmorphism.",
    "Do not use serif or monospace fonts.",
    "Do not make desktop layouts feel like enterprise dashboards.",
    "Do not overload token rows with too much metadata."
  ]
}

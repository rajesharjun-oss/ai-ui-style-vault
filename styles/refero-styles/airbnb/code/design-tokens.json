{
  "name": "Airbnb",
  "version": "2026-07-28",
  "colors": {
    "rausch": {
      "value": "#ff385c",
      "role": "Logo, search submit, active wishlist hearts, and primary action punctuation"
    },
    "rausch600": {
      "value": "#e00b41",
      "role": "Pressed and dark-state accent variant"
    },
    "hof": {
      "value": "#222222",
      "role": "Primary text, headings, icon strokes, and inverse backgrounds"
    },
    "foggy": {
      "value": "#6a6a6a",
      "role": "Secondary text, metadata, helper copy, and disabled icons"
    },
    "grey500": {
      "value": "#c1c1c1",
      "role": "Disabled text, placeholders, and muted icon strokes"
    },
    "deco": {
      "value": "#dddddd",
      "role": "Skeleton placeholders and disabled card states"
    },
    "bebe": {
      "value": "#ebebeb",
      "role": "Hairline borders, input underlines, and dividers"
    },
    "faint": {
      "value": "#f7f7f7",
      "role": "Page canvas, footer, and hover state"
    },
    "white": {
      "value": "#ffffff",
      "role": "Listing cards, input fields, modals, and overlays"
    }
  },
  "font": {
    "primary": "Airbnb Cereal VF, Circular, Inter, DM Sans, system-ui, sans-serif",
    "features": "\"salt\" on",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "typeScale": {
    "caption": {
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.18,
      "letterSpacing": "0"
    },
    "metadata": {
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.33,
      "letterSpacing": "0"
    },
    "small": {
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.23,
      "letterSpacing": "0"
    },
    "body": {
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.43,
      "letterSpacing": "0"
    },
    "ui": {
      "fontSize": "16px",
      "fontWeight": 500,
      "lineHeight": 1.25,
      "letterSpacing": "0"
    },
    "subheading": {
      "fontSize": "20px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "-0.18px"
    },
    "headingSm": {
      "fontSize": "22px",
      "fontWeight": 500,
      "lineHeight": 1.18,
      "letterSpacing": "-0.44px"
    },
    "cardTitleEmphasis": {
      "fontSize": "21px",
      "fontWeight": 700,
      "lineHeight": 1.43,
      "letterSpacing": "0"
    },
    "heading": {
      "fontSize": "28px",
      "fontWeight": 700,
      "lineHeight": 1.43,
      "letterSpacing": "0"
    }
  },
  "spacing": {
    "density": "compact",
    "unit": "4px",
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "40": "40px",
    "44": "44px",
    "48": "48px",
    "maxWidth": "1440px",
    "desktopPadding": "40px",
    "sectionGap": "48px",
    "cardPadding": "12px",
    "elementGap": "12px"
  },
  "radius": {
    "inputs": "8px",
    "ghostButtons": "8px",
    "cards": "12px",
    "images": "12px",
    "searchBar": "9999px",
    "badges": "9999px",
    "buttons": "9999px",
    "avatars": "9999px"
  },
  "shadows": {
    "searchBar": "0px 0px 0px 1px rgba(0, 0, 0, 0.02), 0px 2px 6px 0px rgba(0, 0, 0, 0.04), 0px 4px 8px 0px rgba(0, 0, 0, 0.10)",
    "overlay": "0 8px 28px rgba(0, 0, 0, 0.28)",
    "dropdown": "0 6px 20px rgba(0, 0, 0, 0.2)",
    "tooltip": "0 2px 4px rgba(0, 0, 0, 0.18)",
    "rule": "Do not use shadows on listing cards."
  },
  "imagery": {
    "primary": "Full-bleed property photography",
    "listingAspect": "1:1",
    "avoid": ["illustrations", "3D renders", "abstract graphics", "heavy filters"]
  }
}


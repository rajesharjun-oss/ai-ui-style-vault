  "radii": {
    "cards": "0px",
    "sections": "0px",
    "imageContainers": "0px",
    "tags": "3px",
    "inputs": "3px",
    "buttons": "3px"
  },
  "shadows": {
    "none": "none"
  },
  "componentRecipes": {
    "ghostOutlinedButton": {
      "background": "transparent",
      "border": "1px solid currentColor",
      "radius": "3px",
      "font": "Satoshi 14px 500 uppercase",
      "padding": "20px 28px",
      "shadow": "none"
    },
    "editorialSectionHeading": {
      "font": "TT Ramillas Variable 50px to 115px 300",
      "textTransform": "uppercase",
      "letterSpacing": "-0.0400em to -0.0300em",
      "lineHeight": "0.8 to 0.9"
    },
    "testimonialCard": {
      "background": "#d8cbb8",
      "radius": "0px",
      "border": "none",
      "shadow": "none",
      "stars": "#d49653",
      "body": "Satoshi 14px 500 #2c2c2c"
    },
    "sectionDivider": {
      "borderTop": "1px solid #b6ab9c"
    },
    "navigationBar": {
      "background": "transparent",
      "linkFont": "Satoshi 14px 500 uppercase",
      "controlRadius": "3px"

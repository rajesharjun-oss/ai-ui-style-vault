        "value": "#0f1011",
        "token": "--color-carbon",
        "role": "Card surfaces, product screenshot frames, nav containers"
      },
      "obsidian": {
        "value": "#161718",
        "token": "--color-obsidian",
        "role": "Elevated surfaces and nested panels"
      },
      "graphite": {
        "value": "#23252a",

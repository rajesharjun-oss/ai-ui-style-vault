      "radius": "4px",
      "padding": "0px 6px",
      "variants": ["#27a644", "#eb5757", "#6366f1"]
    },
    "issueCard": {
      "background": "#0f1011",
      "border": "1px solid #23252a",
      "radius": "8px",
      "padding": "12px",
      "title": "15px Inter Variable #d0d6e0",
      "metadata": "12px Berkeley Mono or Inter #62666d"
    },
    "kanbanColumn": {
      "background": "#0f1011",
      "border": "1px solid #23252a",
      "radius": "12px",
      "header": "compact Inter muted text",
      "cards": "issue-card recipe with 8px gaps"
    },
    "aiAgentPanel": {
      "background": "#161718",
      "border": "1px solid #23252a",
      "radius": "12px",
      "accent": "acid-lime indicator or active outline only",
      "content": "compact task rows, issue links, and command metadata"
    }
  },
  "layout": {
    "patterns": [
      "Centered hero with tight headline, short body, CTA row, and product UI preview",
      "Dark top nav with neutral sign-up pill",
      "Kanban board preview with issue cards and agent panels",
      "AI workflow panel with compact rows and active lime indicator",
      "Status badge rows and pill filters",
      "Feature grids using graphite cards and restrained text hierarchy",
      "Docs or changelog sections with mono metadata"
    ],
    "imagery": "Product UI, issue boards, command palettes, agent panels, code-like metadata, and abstract grid geometry"
  },
  "motion": {
    "duration": "150ms to 220ms",
    "easing": "ease",
    "usage": "Subtle border lift, text brighten, or low-opacity fill"
  },
  "do": [
    "Use #08090a as the full-bleed canvas.",
    "Use #e4f222 as the only chromatic action color.",
    "Use hairline graphite borders instead of card shadows.",
    "Keep buttons at 6px radius and cards at 12px max.",
    "Use Inter Variable for normal UI and headings.",
    "Use Berkeley Mono only for issue IDs, shortcuts, and metadata.",
    "Keep component spacing compact.",
    "Let product UI be the main visual texture."
  ],
  "dont": [
    "Do not use decorative gradients on buttons, cards, or text.",
    "Do not introduce extra CTA colors.",
    "Do not use large radii above 12px on cards or panels.",
    "Do not use shadows to separate normal cards from the canvas.",
    "Do not use chromatic text for body copy.",
    "Do not use Berkeley Mono for headings or marketing copy.",
    "Do not make the UI feel like a generic dark SaaS dashboard."
  ]
}

{
  "name": "Orderful",
  "theme": "light",
  "colors": {
    "vermillionSignal": "#e42b0c",
    "inkBlack": "#000000",
    "carbon": "#1f1f1f",
    "slate900": "#101828",
    "slate700": "#364153",
    "slate600": "#4a5565",
    "steel": "#676767",
    "iron": "#8a8a8a",
    "mist": "#99a1af",
    "cloud": "#d4d4d4",
    "frost": "#e5e7eb",
    "paper": "#ffffff",
    "vellum": "#f5f5f5"
  },
  "gradients": {
    "vermillionSignal": "linear-gradient(94deg, #ff0201 -33.85%, #ff7802 -1.54%, #ff0201 73.55%)"
  },
  "typography": {
    "fontFamilies": {
      "primary": "\"telegraf\", Inter, ui-sans-serif, system-ui, sans-serif",
      "secondary": "\"modernGothic\", Inter, ui-sans-serif, system-ui, sans-serif"
    },
    "fontWeights": {
      "thin": 100,
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "micro": { "fontSize": "12px", "lineHeight": "1.5", "letterSpacing": "0.3px" },
      "caption": { "fontSize": "14px", "lineHeight": "1.43", "letterSpacing": "0" },
      "bodySmall": { "fontSize": "16px", "lineHeight": "1.5", "letterSpacing": "0" },
      "body": { "fontSize": "18px", "lineHeight": "1.5", "letterSpacing": "0" },
      "bodyLarge": { "fontSize": "20px", "lineHeight": "1.43", "letterSpacing": "0" },
      "subheading": { "fontSize": "24px", "lineHeight": "1.38", "letterSpacing": "0" },
      "headingSmall": { "fontSize": "30px", "lineHeight": "1.33", "letterSpacing": "0" },
      "heading": { "fontSize": "48px", "lineHeight": "1.2", "letterSpacing": "-1.2px" },
      "headingLarge": { "fontSize": "60px", "lineHeight": "1", "letterSpacing": "-1.5px" },
      "display": { "fontSize": "72px", "lineHeight": "1", "letterSpacing": "-2.16px" }
    }
  },
  "spacing": {
    "unit": "8px",
    "scale": {
      "8": "8px",
      "16": "16px",
      "24": "24px",
      "32": "32px",
      "40": "40px",
      "48": "48px",
      "64": "64px",
      "80": "80px",
      "96": "96px"
    },
    "layout": {
      "pageMaxWidth": "1200px",
      "sectionGap": "64px",
      "cardPadding": "32px",
      "elementGap": "16px"
    }
  },
  "radii": {
    "nav": "8px",
    "tags": "8px",
    "cards": "8px",
    "images": "8px",
    "inputs": "8px",
    "buttons": "8px"
  },
  "shadows": {
    "subtle": "rgba(0, 0, 0, 0.1) 0px 1px 3px 0px, rgba(0, 0, 0, 0.1) 0px 1px 2px -1px"
  }
}

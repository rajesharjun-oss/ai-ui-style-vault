  "mood": "research lab notebook at noon",
  "summary": "A typographic editorial product system with pure white surfaces, near-black type, translucent black hairlines, pill controls, minimal elevation, and one black filled CTA.",
  "useWhen": [
    "AI product entry points",
    "Research pages",
    "Documentation hubs",
    "Editorial product announcements",
    "Trust-heavy SaaS interfaces"
  ],
  "avoidWhen": [
    "Colorful campaign pages",
    "Gaming interfaces",
    "Dense admin dashboards",
    "Brand systems that need multiple accent colors"
  ],
  "colors": {
    "obsidian": {
      "value": "#000000",
      "role": "Primary text, filled action, strongest emphasis"
    },
    "graphite": {
      "value": "#666666",
      "role": "Captions, helper copy, muted labels"
    },
    "smoke": {
      "value": "#8f8f8f",
      "role": "Tertiary copy, disabled states, placeholders, icons"
    },
    "paper": {
      "value": "#ffffff",
      "role": "Page background, cards, inputs"
    },
    "ash": {
      "value": "#f1f1f1",
      "role": "Subtle surface fill and hover state"
    },
    "hairline": {
      "value": "rgba(0,0,0,0.12)",
      "hexApprox": "#0000001f",
      "role": "Borders, dividers, button outlines"
    },
    "whisper": {
      "value": "rgba(0,0,0,0.04)",
      "hexApprox": "#0000000a",
      "role": "Tiny support accent and soft hover"
    }
  },
  "typography": {

  "guidance": {
    "do": [
      "Use the blue-to-teal gradient only on the hero.",
      "Set display headlines in perfectlyNineties or a chunky editorial substitute.",
      "Set body and product UI in haffer or a neutral sans.",
      "Use 8px radius for buttons, inputs, and nav.",
      "Use 14px radius for product rows and 18px for feature blocks and graph nodes.",
      "Keep product surfaces white with 1px borders and subtle shadows.",
      "Use pastel washes for marketing feature blocks.",
      "Color icons categorically with the named marker palette."
    ],
    "dont": [
      "Do not repeat the gradient sky outside the hero.",
      "Do not use the display face for body text, nav, buttons, or product UI.",
      "Do not skip 1px borders on product cards.",
      "Do not use 4px radius for feature cards or marketing blocks.",
      "Do not introduce new chromatic accents beyond the named marker palette.",
      "Do not center body copy inside product UI.",
      "Do not use pure black for text."
    ]
  }

{
  "name": "Altitude",
  "source": {
    "type": "refero-styles",
    "url": "https://styles.refero.design/style/0e971626-ca51-45ba-acf6-35a53c561b2c",
    "capturedOn": "2026-07-28"
  },
  "theme": "dark",
  "colors": {
    "carbonCanvas": { "value": "#181818", "css": "--color-carbon-canvas" },
    "obsidian": { "value": "#111111", "css": "--color-obsidian" },
    "graphiteCard": { "value": "#1f1f1f", "css": "--color-graphite-card" },
    "slateElevated": { "value": "#262626", "css": "--color-slate-elevated" },
    "ironPeak": { "value": "#323232", "css": "--color-iron-peak" },
    "bone": { "value": "#eeeeee", "css": "--color-bone" },
    "ash": { "value": "#e4e4e4", "css": "--color-ash" },
    "fog": { "value": "#a4a19b", "css": "--color-fog" },
    "smoke": { "value": "#5e5d59", "css": "--color-smoke" },
    "pewter": { "value": "#4b4b4b", "css": "--color-pewter" },
    "pureWhite": { "value": "#ffffff", "css": "--color-pure-white" },
    "voltageBlue": { "value": "#2b7fff", "css": "--color-voltage-blue" },
    "midNavy": { "value": "#1a365d", "css": "--color-mid-navy" }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "value": "Libre Baskerville",
        "css": "--font-libre-baskerville",
        "fallback": "Source Serif Pro, Lora, Crimson Text, serif"
      },
      "body": {
        "value": "Inter",
        "css": "--font-inter",
        "fallback": "system-ui, -apple-system, Segoe UI, sans-serif"
      },
      "code": {
        "value": "Fira Code",
        "css": "--font-fira-code",
        "fallback": "JetBrains Mono, IBM Plex Mono, monospace"
      }
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "caption": {
        "fontSize": "10px",
        "lineHeight": 1.5,
        "letterSpacing": "0.5px"
      },
      "body": {
        "fontSize": "14px",
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "headingSm": {
        "fontSize": "18px",
        "lineHeight": 1.43,
        "letterSpacing": "-0.45px"
      },
      "heading": {
        "fontSize": "28px",
        "lineHeight": 1.38,
        "letterSpacing": "-0.7px"
      },
      "headingLg": {
        "fontSize": "36px",
        "lineHeight": 1.15,
        "letterSpacing": "-0.9px"
      },
      "display": {
        "fontSize": "72px",
        "lineHeight": 1.1,
        "letterSpacing": "-1.8px"
      }
    }
  },
  "spacing": {
    "baseUnit": "4px",
    "pageMaxWidth": "1200px",
    "sectionGap": "80px",
    "cardPadding": "12px",
    "elementGap": "8px",
    "scale": ["4px", "8px", "12px", "16px", "20px", "24px", "32px", "48px", "64px", "80px", "96px", "128px", "136px", "224px"]
  },
  "radii": {
    "icons": "4px",
    "badges": "4px",
    "inputs": "4px",
    "buttons": "4px",
    "cards": "8px",
    "largeSurfaces": "16px"
  },
  "shadows": {
    "card": "rgba(51, 51, 51, 0.05) 0px 2px 15px 0px, rgba(51, 51, 51, 0.05) 0px 1px 2px -1px",
    "button": "oklab(0 0 0 / 0.2) 0px 0px 0px 1px, rgba(51, 51, 51, 0.05) 0px 2px 15px 0px, rgba(51, 51, 51, 0.05) 0px 1px 2px -1px",
    "modal": "oklab(0.999994 0.0000455678 0.0000200868 / 0.1) 0px 0px 0px 1px, rgba(0, 0, 0, 0.3) 0px 8px 24px 0px, rgba(0, 0, 0, 0.2) 0px 2px 8px 0px"
  },
  "componentRecipes": {
    "neutralButton": {
      "background": "transparent or #1f1f1f",
      "border": "1px solid #262626",
      "radius": "4px",
      "font": "Inter 14px 600",
      "color": "#eeeeee"
    },
    "serifHeader": {
      "font": "Libre Baskerville",
      "fontWeight": 400,
      "fontSizeRange": "36px to 72px",
      "letterSpacing": "-0.025em",
      "color": "#eeeeee"
    },
    "terminalWindow": {
      "background": "#1f1f1f",
      "border": "1px solid #262626",
      "radius": "8px",
      "font": "Fira Code",
      "tracking": "0.1em"
    },
    "dataRow": {
      "font": "Inter 13px",
      "textColor": "#eeeeee",
      "mutedColor": "#a4a19b",
      "divider": "#262626"
    }
  }
}

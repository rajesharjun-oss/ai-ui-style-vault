    "referenceUrl": "https://atlantic.vc",
    "capturedOn": "2026-07-28"
  },
  "theme": "dark",
  "colors": {
    "deepMidnight": { "value": "#000000", "css": "--color-deep-midnight" },
    "charcoalCanvas": { "value": "#0d0d0f", "css": "--color-charcoal-canvas" },
    "graphiteBase": { "value": "#232529", "css": "--color-graphite-base" },
    "coolStone": { "value": "#2b2f33", "css": "--color-cool-stone" },
    "ghostInk": { "value": "#d8eaff", "css": "--color-ghost-ink" },
    "mutedAsh": { "value": "#6c757f", "css": "--color-muted-ash" },
    "subtleGrey": { "value": "#565e66", "css": "--color-subtle-grey" },
    "paleSlate": { "value": "#565657", "css": "--color-pale-slate" },
    "electricBlue": { "value": "#1f58f2", "css": "--color-electric-blue" },
    "ignitionOrange": { "value": "#ff4105", "css": "--color-ignition-orange" }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "value": "Monument",
        "css": "--font-monument",
        "fallback": "Montserrat, ui-sans-serif, system-ui, sans-serif"
      },
      "mono": {
        "value": "Mono",
        "css": "--font-mono",
        "fallback": "Space Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      }
    },
    "fontWeights": {
      "regular": 400
    },
    "scale": {
      "caption": { "fontSize": "10px", "lineHeight": 0.8, "letterSpacing": "0.16px" },
      "body": { "fontSize": "14px", "lineHeight": 1.5, "letterSpacing": "0.06px" },
      "heading": { "fontSize": "24px", "lineHeight": 1.24, "letterSpacing": "-0.01px" },
      "headingLg": { "fontSize": "64px", "lineHeight": 1.46, "letterSpacing": "-0.03em" },
      "display": { "fontSize": "96px", "lineHeight": 1.5, "letterSpacing": "-0.03em" }
    }
  },
  "spacing": {
    "baseUnit": "4px",
    "pageMaxWidth": "none",
    "sectionGap": "50px",
    "cardPadding": "24px",
    "elementGap": "16px",
    "scale": ["4px", "8px", "12px", "16px", "20px", "24px", "32px", "80px", "100px", "148px", "200px", "240px"]

  "shadows": {
    "none": "none"
  },
  "componentRecipes": {
    "ghostNavigationLink": {
      "background": "transparent",
      "border": "none",
      "radius": "0px",
      "font": "Monument 400",
      "color": "#d8eaff"
    },
    "outlinedActionButton": {
      "background": "transparent",
      "border": "1px solid #d8eaff",
      "radius": "0px",
      "font": "Monument 16px 400",
      "color": "#d8eaff"
    },
    "textAccentButton": {
      "background": "transparent",
      "border": "none",
      "radius": "0px",
      "font": "Monument 400",
      "color": "#ff4105"
    },
    "standardCard": {
      "background": "#2b2f33 or #0d0d0f",
      "border": "none",
      "radius": "16px",
      "shadow": "none",
      "padding": "24px"
    },
    "heroLargeCard": {
      "background": "#0d0d0f",
      "border": "none",
      "radius": "24px",
      "shadow": "none",
      "padding": "150px 110px"

  "imagery": {
    "style": "Illustration-first and product-mockup-led, no lifestyle photography",
    "rules": [
      "Use product UI mockups for real visuals.",
      "Use decorative character marks and hand-drawn accents as punctuation.",
      "Avoid stock photos, glossy 3D renders, and gradients."
    ]
  },
  "layout": {
    "maxWidth": "1440px",
    "hero": "Centered stack with character marks, large headline, highlight pill, subhead, CTA row, and product UI mockup",
    "sections": [
      "White card grids on warm canvas",
      "Colored accent feature panels",
      "Two-column text plus product panel rows",
      "Greyscale logo wall"
    ]
  },
  "do": [
    "Use #f6f5f4 as the page canvas and #ffffff for cards.",
    "Reserve #0075de for the main filled action.",
    "Apply negative tracking to display sizes.",
    "Use 1px rgba(0,0,0,0.08) borders instead of card shadows.",
    "Use 12px card radius, 8px button radius, and 9999px pills.",
    "Use accent colors for feature-card backgrounds.",
    "Keep motion near 200ms ease."
  ],
  "dont": [
    "Do not use pure white as the page background.",
    "Do not add shadows to normal content cards.",
    "Do not use multiple chromatic filled button colors.",
    "Do not use full-opacity black for every text layer.",
    "Do not use Lyon Text for UI labels or navigation.",
    "Do not use rectangular card radius above 12px.",
    "Do not use gradients as the core surface treatment."
  ]
}

{
  "name": "Hungry Tiger",
  "version": "2026-07-28",
  "colors": {
    "tigerGold": {
      "value": "#faae33",
      "role": "Primary action, filled buttons, active nav, display type, and icon strokes"
    },
    "emberRust": {
      "value": "#823513",
      "role": "Dominant page canvas, hero backdrop, and primary section surface"
    },
    "saffronGlow": {
      "value": "#9f531b",
      "role": "Secondary warm accent, decorative borders, and mid-tone type"
    },
    "chiliRed": {
      "value": "#d1255c",
      "role": "Rare heat-level badge or alert accent"
    },
    "charredClove": {
      "value": "#281006",
      "role": "Deepest surface and text on gold buttons"
    },
    "darkSpice": {
      "value": "#402011",
      "role": "Cards, inputs, ghost fills, and body/support text"
    },
    "cardamomBrown": {
      "value": "#6b2e12",
      "role": "Input borders, subtle dividers, and muted inline elements"
    }
  },
  "font": {
    "display": "Salmond, Druk Wide, Antonio, Bebas Neue, Inter, sans-serif",
    "body": "Graphikx, Inter, Geist, Untitled Sans, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "typeScale": {
    "caption": {
      "fontSize": "11px",
      "fontWeight": 500,
      "lineHeight": 1.2,
      "letterSpacing": "0.02em"
    },
    "micro": {
      "fontSize": "13px",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "0.01em"
    },
    "subheading": {
      "fontSize": "18px",
      "fontWeight": 500,
      "lineHeight": 1.2,
      "letterSpacing": "0.01em"
    },
    "headingSm": {
      "fontSize": "29px",
      "fontWeight": 700,
      "lineHeight": 1.1,
      "letterSpacing": "-0.005em"
    },
    "heading": {
      "fontSize": "65px",
      "fontWeight": 700,
      "lineHeight": 0.95,
      "letterSpacing": "-0.01em"
    },
    "headingLg": {
      "fontSize": "101px",
      "fontWeight": 700,
      "lineHeight": 0.9,
      "letterSpacing": "-0.016em"
    },
    "display": {
      "fontSize": "195px",
      "fontWeight": 700,
      "lineHeight": 0.8,
      "letterSpacing": "-0.02em"
    },
    "displayXl": {
      "fontSize": "213px",
      "fontWeight": 700,
      "lineHeight": 0.8,
      "letterSpacing": "-0.02em"
    }
  },
  "spacing": {
    "density": "comfortable",
    "4": "4px",
    "6": "6px",
    "8": "8px",
    "9": "9px",
    "10": "10px",
    "12": "12px",
    "14": "14px",
    "16": "16px",
    "17": "17px",
    "20": "20px",
    "24": "24px",
    "26": "26px",
    "28": "28px",
    "32": "32px",
    "42": "42px",
    "80": "80px",
    "120": "120px",
    "192": "192px",
    "maxWidth": "1440px",
    "sectionGap": "80px to 120px",
    "cardPadding": "12px to 16px",
    "elementGap": "10px"
  },
  "radius": {
    "cards": "6px",
    "badges": "9999px",
    "inputs": "9999px",
    "buttons": "9999px",
    "icons": "9999px"
  },
  "surfaces": {
    "tandoorCanvas": "#823513",
    "spiceCard": "#402011",
    "charredCore": "#281006"
  },
  "elevation": {
    "allComponents": "none",
    "rule": "Use surface tone and scale instead of depth."
  },
  "motifs": {
    "dottedDivider": "1px dotted #faae33",
    "botanicalWatermark": "Low-opacity warm brown fern, leaf, or floral forms behind content"
  },
  "motion": {
    "allowed": ["border-color shift", "subtle color shift", "opacity shift"],
    "avoid": ["shadow animation", "glow", "parallax", "bounce"]
  }
}


  "theme": {
    "mode": "light",
    "summary": "Editorial zinc grid with confetti-orange punctuation.",
    "principles": [
      "Use a zinc-gray neutral system for almost every UI decision.",
      "Reserve orange for credential badges and small emphasis moments.",
      "Use white cards with hairline borders instead of shadows.",
      "Keep the system single-font and spacious with large rounded cards."
    ]
  },
  "colors": {

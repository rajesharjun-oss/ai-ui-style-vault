  "imagery": {
    "style": "Structural photography and real product/work imagery.",
    "rules": [
      "Use category cards with real product or work images.",
      "Use full-width landscape or macro photo dividers.",
      "Use grayscale logo strips without framed containers."
    ]
  },
  "do": [
    "Use #09090b for primary actions.",
    "Use 36px card radius with 1px Cloud borders.",
    "Use no drop shadows on cards.",
    "Set body text to 14px to 15px Cosmica 400 in Graphite.",
    "Reserve Ember for credential chips and small punctuation.",
    "Use 56px to 64px Cosmica 600 for display headings.",
    "Use 28px card padding and 80px section rhythm."
  ],
  "dont": [
    "Do not introduce new accent colors.",
    "Do not add drop shadows to cards.",
    "Do not set display headlines below weight 600.",
    "Do not use Ember for body text, links, or large fills.",
    "Do not use container radii below 12px.",
    "Do not break the single-font rule.",
    "Do not use pure black #000000; use Obsidian instead."
  ]
}

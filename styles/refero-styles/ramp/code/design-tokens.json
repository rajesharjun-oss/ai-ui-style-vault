{
  "name": "Ramp",
  "version": "2026-07-28",
  "colors": {
    "highlighterYellow": {
      "value": "#e4f222",
      "role": "Primary action fill, active state, and money signal"
    },
    "ink": {
      "value": "#0c0a08",
      "role": "Main text, headings, outlines, and icons"
    },
    "obsidian": {
      "value": "#1a1919",
      "role": "Inverted sections and counter strip"
    },
    "ash": {
      "value": "#6d6c6b",
      "role": "Muted text, captions, and labels"
    },
    "smoke": {
      "value": "#d3d3d3",
      "role": "Subtle surfaces and skeletons"
    },
    "hairline": {
      "value": "#e5e7eb",
      "role": "Borders, grid lines, and dividers"
    },
    "bone": {
      "value": "#f4f2f0",
      "role": "Canvas, hover fills, and wash cards"
    },
    "paper": {
      "value": "#ffffff",
      "role": "Cards, modals, panels, and reversed text"
    }
  },
  "font": {
    "family": "\"lausanne\", Inter, \"IBM Plex Sans\", Sohne, Arial, sans-serif",
    "weight": 400,
    "featureSettings": "\"ss01\""
  },
  "typeScale": {
    "micro": {
      "fontSize": "10px",
      "lineHeight": 2.2,
      "letterSpacing": "0.018em",
      "textTransform": "uppercase"
    },
    "small": {
      "fontSize": "13px",
      "lineHeight": 1.4,
      "letterSpacing": "0"
    },
    "body": {
      "fontSize": "16px",
      "lineHeight": 1.5,
      "letterSpacing": "0"
    },
    "bodyLarge": {
      "fontSize": "18px",
      "lineHeight": 1.45,
      "letterSpacing": "0"
    },
    "subheading": {
      "fontSize": "20px",
      "lineHeight": 1.3,
      "letterSpacing": "0"
    },
    "headingSmall": {
      "fontSize": "24px",
      "lineHeight": 1.17,
      "letterSpacing": "0"
    },
    "heading": {
      "fontSize": "28px",
      "lineHeight": 1.14,
      "letterSpacing": "0"
    },
    "headingLarge": {
      "fontSize": "40px",
      "lineHeight": 1.05,
      "letterSpacing": "0"
    },
    "display": {
      "fontSize": "64px",
      "lineHeight": 1,
      "letterSpacing": "0"
    }
  },
  "spacing": {
    "base": "4px",
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "20px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "40px",
    "4xl": "48px",
    "section": "64px",
    "sectionLarge": "128px",
    "maxWidth": "1200px"
  },
  "radius": {
    "tag": "6px",
    "button": "6px",
    "input": "10px",
    "washCard": "12px",
    "card": "16px"
  },
  "borders": {
    "hairline": "1px solid #e5e7eb",
    "input": "1px solid rgba(33, 33, 33, 0.1)"
  },
  "shadow": {
    "card": "none",
    "navInset": "rgba(255, 255, 255, 0.6) 0 0 2px 0 inset"
  },
  "motion": {
    "duration": "300ms to 400ms",
    "easing": "ease-out",
    "properties": ["background-color", "border-color", "color", "fill", "stroke", "opacity"]
  }
}


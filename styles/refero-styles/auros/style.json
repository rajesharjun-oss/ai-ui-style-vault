  "guidance": {
    "do": [
      "Use abyss-black backgrounds with blue and cyan reserved for focal action and data signal.",
      "Use oversized tight headings for hero and editorial moments.",
      "Use pill geometry for CTAs, nav chips, and ticker rails.",
      "Pair Satoshi for headings and UI with Space Mono for trading data.",
      "Layer translucent dark panels over controlled glow.",
      "Keep green and red tied to financial meaning.",
      "Keep dashboards dense, calm, and divided by fine lines.",
      "Use map or network imagery as luminous infrastructure."
    ],
    "dont": [
      "Do not add warm orange accents beyond controlled gold metric emphasis.",
      "Do not turn the aurora gradient into a full-page wash.",
      "Do not set body copy in the mono font.",
      "Do not add light theme sections.",
      "Do not over-round major cards into blob shapes.",
      "Do not use generic blue-and-white SaaS card layouts.",
      "Do not overanimate dashboards.",
      "Do not use lifestyle photography as the main visual language."
    ]
  }

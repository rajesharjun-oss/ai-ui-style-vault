{
  "name": "Steep",
  "source": "Refero Styles",
  "url": "https://styles.refero.design/style/75fdb89f-ca64-41b3-af36-7a78bd09448e",
  "licenseStatus": "inspiration-only-unless-explicitly-licensed",
  "colors": {
    "inkBlack": "#17191c",
    "paperWhite": "#ffffff",
    "mistGray": "#f2f2f3",
    "fogWhite": "#fafafb",
    "slateGray": "#777b86",
    "ashGray": "#979799",
    "smokeGray": "#a3a6af",
    "blushPeach": "#fbe1d1",
    "siennaBrown": "#5d2a1a"
  },
  "surfaces": {
    "canvas": "#ffffff",
    "cardMist": "#f2f2f3",
    "sectionFog": "#fafafb",
    "accentBlush": "#fbe1d1",
    "elevatedWhite": "#ffffff"
  },
  "typography": {
    "fonts": {
      "signifier": {
        "token": "--font-signifier",
        "substitutes": ["GT Sectra", "Tiempos Headline", "Source Serif 4", "Georgia"],
        "weights": [400],
        "role": "Display and headline serif for H1/H2 moments only."
      },
      "sohne": {
        "token": "--font-sohne",
        "substitutes": ["Inter", "ui-sans-serif", "system-ui"],
        "weights": [400, 430, 450, 480, 500],
        "role": "Body, UI, navigation, buttons, cards, labels, and metadata."
      }
    },
    "scale": {
      "caption": { "size": "15px", "lineHeight": 1.5, "letterSpacing": "normal" },
      "body": { "size": "17px", "lineHeight": 1.35, "letterSpacing": "normal" },
      "bodyLg": { "size": "20px", "lineHeight": 1.35, "letterSpacing": "normal" },
      "subheading": { "size": "22px", "lineHeight": 1.5, "letterSpacing": "normal" },
      "headingSm": { "size": "26px", "lineHeight": 1.18, "letterSpacing": "-0.23px" },
      "heading": { "size": "44px", "lineHeight": 1.3, "letterSpacing": "-0.66px" },
      "headingLg": { "size": "64px", "lineHeight": 1.3, "letterSpacing": "-0.96px" },
      "display": { "size": "90px", "lineHeight": 1.3, "letterSpacing": "-2.25px" }
    }
  },
  "spacing": {
    "unit": "4px",
    "density": "comfortable",
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "20px",
      "24px",
      "28px",
      "32px",
      "40px",
      "64px",
      "80px",
      "96px",
      "124px",
      "128px",
      "160px"
    ],
    "layout": {
      "pageMaxWidth": "1200px",
      "sectionGap": "80px",
      "cardPadding": "20px",
      "elementGap": "8px"
    }
  },
  "radii": {
    "images": "12px",
    "inputs": "16px",
    "smallCards": "16px",
    "elevatedCards": "20px",
    "cards": "24px",
    "buttons": "9999px"
  },
  "shadows": {
    "subtle": "oklab(0 0 0 / 0.05) 0px 0px 0px 1px, rgba(0, 0, 0, 0.08) 0px 4px 24px 0px",
    "subtle2": "oklab(0 0 0 / 0.05) 0px 0px 0px 1px, rgba(0, 0, 0, 0.1) 0px 8px 40px 0px",
    "subtle3": "rgba(4, 23, 43, 0.05) 0px 0px 0px 1px, rgba(0, 0, 0, 0.1) 0px 20px 25px -5px, rgba(0, 0, 0, 0.1) 0px 8px 10px -6px"
  },
  "rules": {
    "do": [
      "Use Signifier weight 400 for display headings.",
      "Use peach at most once per page for editorial emphasis.",
      "Use full pill radius for buttons and 24px radius for content cards.",
      "Pair filled pill buttons with ghost pill buttons.",
      "Use Sohne half-step weights for body hierarchy.",
      "Keep the 4px base unit and 80px section rhythm.",
      "Use floating product artifacts instead of dense dashboard shells."
    ],
    "dont": [
      "Do not introduce chromatic colors beyond peach and brown.",
      "Do not use bold or semibold Signifier headings.",
      "Do not apply drop shadows to neutral or peach content cards.",
      "Do not use sharp card radii.",
      "Do not underline text links at rest.",
      "Do not place peach cards on dark or colored backgrounds.",
      "Do not use Sienna Brown as normal body text on white."
    ]
  }
}


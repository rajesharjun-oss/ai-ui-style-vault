  "referenceSite": "https://spacex.com",
  "theme": "dark",
  "tokens": {
    "color": {
      "voidBlack": {
        "value": "#000000",
        "role": "Page canvas and every section background"
      },
      "starWhite": {
        "value": "#f0f0fa",
        "role": "Primary foreground for text, icons, nav, buttons, and borders"
      },
      "dimSteel": {
        "value": "#545457",
        "role": "Secondary outlines, muted labels, quiet dividers"
      },
      "darkGunmetal": {
        "value": "#404040",
        "role": "Low-emphasis separators and barely visible structural lines"
      }
    },
    "font": {
      "primary": {
        "family": "D-DIN",
        "fallback": "Barlow",
        "weights": [400, 700],
        "features": ["tnum", "ss01"]

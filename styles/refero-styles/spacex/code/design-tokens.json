      "headline": {
        "family": "D-DIN-Bold",
        "fallback": "Barlow Bold",
        "weights": [700]
      }
    },
    "typography": {
      "caption": {
        "fontSize": "10px",
        "fontWeight": 400,
        "lineHeight": "0.94-1.5",
        "letterSpacing": "0.09em"

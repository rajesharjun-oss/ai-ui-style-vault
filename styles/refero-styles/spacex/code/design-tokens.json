        "fontWeight": 400,
        "lineHeight": "1.0-1.5",
        "letterSpacing": "0.10em"
      },
      "body": {
        "fontSize": "13px",
        "fontWeight": "400-700",
        "lineHeight": "0.94-1.7",
        "letterSpacing": "0.10em"
      },
      "bodyLarge": {
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0.10em"

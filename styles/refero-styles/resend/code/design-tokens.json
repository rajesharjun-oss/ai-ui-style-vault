      "lineHeight": 1.5,
      "spacing": "compact vertical rhythm"
    },
    "emailPreviewCard": {
      "background": "#ffffff inside dark frame, or dark preview shell with white email body",
      "frame": "#111111 with 1px #2a2a2a border",
      "radius": "12px",
      "header": "compact dark toolbar or metadata row",
      "content": "white email surface for contrast"
    },
    "apiKeyRow": {
      "background": "#111111",
      "border": "1px solid #2a2a2a",
      "radius": "8px",
      "keyText": "Commit Mono muted gray",

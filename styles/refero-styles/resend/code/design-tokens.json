    },
    "statusBadge": {
      "background": "#151515",
      "color": "semantic state color or muted gray",
      "border": "1px solid #2a2a2a",
      "radius": "999px",
      "padding": "4px 10px",
      "font": "12px sans 500"
    },
    "navigationBar": {
      "background": "transparent or rgba(7,7,7,0.86)",
      "text": "muted gray, 14px sans",
      "cta": "white primary button",
      "border": "optional 1px solid #1f1f1f",
      "backdrop": "subtle blur only if sticky"
    },
    "docsCard": {
      "background": "#111111",
      "border": "1px solid #2a2a2a",
      "radius": "12px",
      "padding": "24px",
      "title": "white sans",
      "description": "muted gray",
      "footer": "code label or link in violet"
    }

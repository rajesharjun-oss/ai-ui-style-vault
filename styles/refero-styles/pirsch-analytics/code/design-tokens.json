  "layout": {
    "patterns": [
      "Hero with large bold headline, short privacy-focused subhead, sunshine CTA, and analytics dashboard preview",
      "Paper sections alternating between #fffffb and #f5f1e6",
      "Bordered dashboard panels with charts, metrics, and tables",
      "Feature cards arranged in a simple grid with ink borders",
      "Pricing or plan cards with sunshine highlights",
      "Privacy or compliance badges in deep mint"
    ],
    "imagery": "Product dashboards, charts, metric tiles, map panels, referrer tables, and event rows"
  },
  "motion": {
    "duration": "150ms to 200ms",
    "easing": "ease",
    "usage": "Minimal hover feedback; buttons can shift slightly or change fill"
  },
  "do": [
    "Use warm paper surfaces instead of sterile white sections.",
    "Use black ink borders as a core design material.",
    "Use #ffda6e for primary CTAs and emphasis panels.",
    "Use mint for analytics, success, and privacy status.",
    "Use DM Sans only.",
    "Use 3px card radius and 7px button radius.",
    "Keep cards shadow-free.",
    "Use uppercase heavy captions for labels."
  ],
  "dont": [
    "Do not add box shadows or glossy gradients.",
    "Do not use large rounded SaaS cards.",
    "Do not use more than one primary CTA color.",
    "Do not hide all structure behind muted borders.",
    "Do not introduce serif, monospace, or decorative fonts.",
    "Do not make analytics panels look like enterprise glass dashboards."
  ]

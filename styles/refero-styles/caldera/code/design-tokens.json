    "secondaryOutlineButton": {
      "background": "transparent or #f2ede7",
      "border": "1px solid #000000",
      "radius": "40px",
      "font": "DM Sans 16px 600",
      "color": "#000000"
    },
    "roundedCard": {
      "background": "#f2ede7",
      "border": "1px solid #000000 or #b6b0aa",
      "radius": "40px",
      "padding": "40px"
    },
    "networkBadge": {
      "background": "#e8ff50",
      "border": "1px solid #000000",
      "radius": "800px",
      "font": "DM Sans 14px 600"

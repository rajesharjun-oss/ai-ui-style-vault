        "fallback": "Arial Narrow, Helvetica Neue Condensed, Inter Tight, sans-serif"
      },
      "body": {
        "value": "DM Sans",
        "css": "--font-dm-sans",
        "fallback": "Inter, system-ui, sans-serif"
      }
    },
    "fontWeights": {
      "display": 530,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "micro": { "fontSize": "14px", "lineHeight": 1.1, "letterSpacing": "0" },
      "body": { "fontSize": "16px", "lineHeight": 1.25, "letterSpacing": "0" },
      "bodyLg": { "fontSize": "24px", "lineHeight": 1.15, "letterSpacing": "0" },
      "heading": { "fontSize": "48px", "lineHeight": 1.05, "letterSpacing": "-1.44px" },
      "display": { "fontSize": "128px", "lineHeight": 0.95, "letterSpacing": "-5.76px" }
    }
  },
  "spacing": {
    "baseUnit": "4px",
    "pageMaxWidth": "1280px",
    "sectionGap": "160px",
    "cardPadding": "40px",
    "elementGap": "16px",
    "scale": ["4px", "8px", "12px", "16px", "20px", "24px", "32px", "40px", "48px", "56px", "64px", "80px", "96px", "120px", "160px", "200px"]

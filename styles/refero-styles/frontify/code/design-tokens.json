{
  "name": "Frontify",
  "slug": "frontify",
  "source": "https://styles.refero.design/style/8f42603d-7ff9-446e-99a3-6bdd1f388ae5",
  "referenceSite": "https://www.frontify.com",
  "theme": "light",
  "color": {
    "warmParchment": { "value": "#f0f0eb", "role": "page canvas and broad section fill" },
    "galleryWhite": { "value": "#ffffff", "role": "cards, panels, and reversed text" },
    "softLinen": { "value": "#e1e1db", "role": "secondary grouped surfaces" },
    "mistGray": { "value": "#d7d7cf", "role": "subtle fills and dividers" },
    "paleStone": { "value": "#cbcbc5", "role": "light hairline borders" },
    "ashGray": { "value": "#bfbfb8", "role": "icon strokes and muted borders" },
    "graphiteWarm": { "value": "#575753", "role": "secondary text and labels" },
    "charcoalWarm": { "value": "#464643", "role": "strong secondary copy and rules" },
    "ink": { "value": "#111110", "role": "primary text, buttons, and structural borders" },
    "signalOrange": { "value": "#ff3b00", "role": "small accent and active punctuation" },
    "deepTeal": { "value": "#042a2b", "role": "dark hero and editorial sections" }
  },
  "font": {
    "display": {
      "family": "Cranny",
      "fallback": "Fraunces, Playfair Display, DM Serif Display, Georgia, serif",
      "weights": [300, 400],
      "usage": "hero and section headlines"
    },
    "ui": {
      "family": "ABC Diatype",
      "fallback": "Inter, Sohne, GT America, Arial, sans-serif",
      "weights": [400, 500],
      "usage": "body, navigation, buttons, labels, breadcrumbs, product UI"
    },
    "secondary": {
      "family": "Satoshi",
      "fallback": "DM Sans, Manrope, Arial, sans-serif",
      "weights": [400],
      "usage": "optional compact body copy"
    },
    "heavyDisplay": {
      "family": "Cabinetgrotesk",
      "fallback": "Cabinet Grotesk, General Sans, Arial, sans-serif",
      "weights": [500, 700],
      "usage": "rare display emphasis and numerals"
    }
  },
  "text": {
    "caption": { "size": "14px", "lineHeight": "1.3", "tracking": "0.010em" },
    "body": { "size": "16px", "lineHeight": "1.43", "tracking": "0.010em" },
    "bodyLarge": { "size": "18px", "lineHeight": "1.43", "tracking": "0.010em" },
    "subheading": { "size": "24px", "lineHeight": "1.1", "tracking": "0" },
    "headingSmall": { "size": "40px", "lineHeight": "1.0", "tracking": "-0.006em" },
    "heading": { "size": "61px", "lineHeight": "0.95", "tracking": "-0.008em" },
    "display": { "size": "88px", "lineHeight": "0.88", "tracking": "-0.008em" }
  },
  "space": {
    "unit": "8px",
    "element": "16px",
    "card": "32px",
    "section": "80px",
    "pageMax": "1200px"
  },
  "radius": {
    "card": "8px",
    "image": "18px",
    "navPill": "32px",
    "buttonLarge": "40px",
    "buttonSmall": "24px",
    "tag": "9999px"
  },
  "component": {
    "button": {
      "font": "ABC Diatype",
      "size": "14px",
      "weight": 500,
      "padding": "12px 20px",
      "radius": "24px to 40px"
    },
    "card": {
      "background": "#ffffff",
      "border": "1px solid #cbcbc5",
      "radius": "8px",
      "padding": "32px",
      "shadow": "none"
    },
    "hero": {
      "background": "#042a2b",
      "headingFont": "Cranny",
      "headingSize": "80px to 96px",
      "contentAlign": "center"
    }
  }
}

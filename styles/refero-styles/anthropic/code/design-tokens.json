{
  "name": "Anthropic",
  "source": "Refero Styles",
  "url": "https://styles.refero.design/style/d469cba4-c448-4a43-a033-883f8bfcdc42",
  "licenseStatus": "inspiration-only-unless-explicitly-licensed",
  "colors": {
    "slateDark": "#141413",
    "ivoryMedium": "#f0eee6",
    "ivoryLight": "#faf9f5",
    "cloudMedium": "#b0aea5",
    "cloudDark": "#87867f",
    "stone": "#cccbc8",
    "slateMedium": "#3d3d3a",
    "oatWarm": "#e3dacc",
    "manilla": "#f5e3c7",
    "clay": "#d97757",
    "clayDeep": "#c6613f"
  },
  "surfaces": {
    "canvas": "#f0eee6",
    "cardSurface": "#faf9f5",
    "warmFeatureSurface": "#f5e3c7",
    "deepWarmSurface": "#e3dacc",
    "inversionSurface": "#141413"
  },
  "typography": {
    "fonts": {
      "anthropicSerif": {
        "token": "--font-anthropic-serif",
        "substitutes": ["Georgia", "Source Serif Pro", "Charter"],
        "weights": [400, 600],
        "role": "Editorial body, display heading, card titles, and supporting paragraphs."
      },
      "anthropicSans": {
        "token": "--font-anthropic-sans",
        "substitutes": ["Inter", "system-ui", "Arial"],
        "weights": [400, 500, 600, 700],
        "role": "UI chrome, navigation, buttons, footers, badges, and declarative display."
      },
      "anthropicMono": {
        "token": "--font-anthropic-mono",
        "substitutes": ["JetBrains Mono", "SF Mono", "Menlo"],
        "weights": [400],
        "role": "Code and technical snippets only."
      }
    },
    "scale": {
      "caption": { "size": "12px", "lineHeight": 1.4, "letterSpacing": "-0.24px" },
      "bodySm": { "size": "16px", "lineHeight": 1, "letterSpacing": "-0.08px" },
      "body": { "size": "20px", "lineHeight": 1.4, "letterSpacing": "normal" },
      "subheading": { "size": "24px", "lineHeight": 1.3, "letterSpacing": "-0.05px" },
      "heading": { "size": "61px", "lineHeight": 1.1, "letterSpacing": "-0.12px" },
      "display": { "size": "68px", "lineHeight": 1.1, "letterSpacing": "normal" }
    }
  },
  "spacing": {
    "unit": "4px",
    "density": "compact",
    "scale": ["4px", "8px", "12px", "16px", "24px", "32px", "76px", "100px"],
    "layout": {
      "pageMaxWidth": "1280px",
      "sectionGap": "80px-120px",
      "cardPadding": "24px-32px",
      "elementGap": "8px"
    }
  },
  "radii": {
    "nav": "0px",
    "cards": "24px",
    "links": "0px",
    "badges": "0px",
    "filledButtons": "8px bottom-only",
    "outlinedButtons": "12px"
  },
  "elevation": {
    "cards": "none; elevated by surface tone shift",
    "buttons": "none; identity through fill and bottom-corner radius",
    "navigation": "none; flat on parchment"
  },
  "visualLanguage": {
    "primary": "scientific field journal",
    "imagery": "vintage naturalist illustration and warm editorial plates",
    "avoid": ["photography", "product screenshots", "abstract gradients", "background glows"]
  },
  "rules": {
    "do": [
      "Use Anthropic Serif at 20px for body copy.",
      "Use Anthropic Sans at 12px to 16px for UI chrome.",
      "Use Ivory Medium as the page canvas and Ivory Light for cards.",
      "Use Manilla only for featured editorial cards.",
      "Use bottom-only 8px radius on filled ivory buttons.",
      "Use Clay only for the most consequential CTA.",
      "Keep inline links persistently underlined.",
      "Use a dark footer as the main inversion surface."
    ],
    "dont": [
      "Do not introduce cool grays, blues, or colors outside the warm earth-tone family.",
      "Do not use box-shadow for elevation.",
      "Do not use Clay for decoration or non-CTA elements.",
      "Do not set body text in sans-serif when the editorial voice matters.",
      "Do not apply uniform generic radius to filled buttons.",
      "Do not use pure white as a main surface.",
      "Do not add gradients, glows, or color washes to backgrounds."
    ]
  }
}


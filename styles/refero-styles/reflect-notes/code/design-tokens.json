{
  "name": "Reflect Notes",
  "slug": "reflect-notes",
  "sourceUrl": "https://styles.refero.design/style/e7f92774-3c08-402b-917d-020ba1f3d489",
  "referenceSite": "https://reflect.app",
  "theme": "dark",
  "colors": {
    "void-canvas": "#030014",
    "midnight-surface": "#060317",
    "deep-indigo": "#10093a",
    "steel": "#54525f",
    "dusk": "#72707b",
    "fog": "#918ea0",
    "ash": "#a8a6b7",
    "mercury": "#cdccd0",
    "lilac-white": "#f4f0ff",
    "pearl": "#ffffff",
    "lavender-accent": "#9382ff",
    "iris": "#5046e4",
    "cosmic-gradient": "linear-gradient(90.01deg, #e59cff 0.01%, #ba9cff 50.01%, #9cb2ff 100%)",
    "aurora": "linear-gradient(180deg, rgba(183,164,251,0) 0%, #b7a4fb 50%, #8562ff 100%, rgba(133,98,255,0) 100%)"
  },
  "typography": {
    "fontFamily": {
      "display": "\"AeonikPro\", \"Aeonik\", \"Inter\", \"DM Sans\", sans-serif",
      "body": "\"Inter V\", \"Inter\", \"Geist\", system-ui, sans-serif"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500
    },
    "fontSize": {
      "caption": "12px",
      "body-sm": "14px",
      "body": "16px",
      "body-lg": "18px",
      "subheading": "24px",
      "heading-sm": "32px",
      "heading": "48px",
      "heading-lg": "56px",
      "display": "72px"
    },
    "lineHeight": {
      "caption": "1.33",
      "body-sm": "1.43",
      "body": "1.5",
      "body-lg": "1.56",
      "subheading": "1.33",
      "heading-sm": "1.25",
      "heading": "1.17",
      "heading-lg": "1.14",
      "display": "1.11"
    },
    "letterSpacing": {
      "heading-sm": "-0.2px",
      "heading": "-0.3px",
      "heading-lg": "-0.4px",
      "display": "-0.5px"
    }
  },
  "spacing": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "36": "36px",
    "48": "48px",
    "52": "52px",
    "56": "56px",
    "64": "64px",
    "72": "72px",
    "108": "108px",
    "232": "232px"
  },
  "layout": {
    "maxWidth": "1200px",
    "sectionGap": "96px to 120px",
    "cardPadding": "24px to 32px",
    "elementGap": "8px to 16px"
  },
  "radius": {
    "button": "5px",
    "input": "5px",
    "card": "16px",
    "feature-block": "24px",
    "badge": "32px",
    "nav-pill": "999px"
  },
  "elevation": {
    "surface-glow": "rgba(255, 255, 255, 0.04) 0px 0px 24px 0px inset",
    "surface-glow-strong": "rgba(255, 255, 255, 0.06) 0px 0px 24px 0px inset",
    "badge-glow": "rgba(164, 143, 255, 0.12) 0px -7px 11px 0px inset",
    "external-shadow": "none"
  },
  "components": {
    "navigation-pill": {
      "background": "{colors.midnight-surface}",
      "radius": "{radius.nav-pill}",
      "shadow": "{elevation.surface-glow}",
      "height": "40px"
    },
    "primary-cta-button": {
      "background": "{colors.iris}",
      "text": "{colors.pearl}",
      "radius": "{radius.button}",
      "padding": "10px 16px",
      "fontWeight": "{typography.fontWeight.medium}"
    },
    "ai-badge-pill": {
      "background": "{colors.midnight-surface}",
      "border": "1px solid {colors.iris}",
      "radius": "{radius.badge}",
      "shadow": "{elevation.badge-glow}",
      "text": "{colors.lilac-white}"
    },
    "testimonial-card": {
      "background": "{colors.midnight-surface}",
      "radius": "{radius.card}",
      "padding": "24px",
      "shadow": "{elevation.surface-glow}"
    }
  }
}

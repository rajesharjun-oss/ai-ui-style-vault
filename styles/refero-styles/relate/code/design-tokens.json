{
  "name": "Relate",
  "version": "2026-07-28",
  "colors": {
    "royalSignal": {
      "value": "#145aff",
      "role": "Main brand accent, links, logo mark, active dots, and hero highlight word"
    },
    "cobaltGlow": {
      "value": "#3b82f6",
      "role": "Blue wash, soft highlight, and small blue status dot"
    },
    "mintWin": {
      "value": "#16ca2e",
      "role": "Small green positive status or short emphasis"
    },
    "coralLost": {
      "value": "#f26052",
      "role": "Small red/orange badge or negative status"
    },
    "amberPending": {
      "value": "#ffa64d",
      "role": "Pending status dot or short emphasis"
    },
    "azureFocus": {
      "value": "#0099ff",
      "role": "Input focus glow"
    },
    "midnightInk": {
      "value": "#020520",
      "role": "Hero and section headings"
    },
    "graphiteBody": {
      "value": "#14141e",
      "role": "Body text, UI labels, and secondary headings"
    },
    "slateCaption": {
      "value": "#374151",
      "role": "Muted body copy, nav labels, and lists"
    },
    "ashHelper": {
      "value": "#6b7280",
      "role": "Helper text, metadata, and timestamps"
    },
    "stoneDivider": {
      "value": "#e2e8f0",
      "role": "Hairline borders, card edges, and dividers"
    },
    "lavenderWash": {
      "value": "#f0f4fe",
      "role": "Hero and feature band tint"
    },
    "fogSurface": {
      "value": "#f1f5f9",
      "role": "Inputs, disabled states, and subtle groups"
    },
    "snowCanvas": {
      "value": "#fcfcfc",
      "role": "Page background, nav, and neutral surface"
    },
    "whiteCard": {
      "value": "#ffffff",
      "role": "Product UI cards and inner cards"
    }
  },
  "font": {
    "primary": "Inter, DM Sans, Geist, Manrope, Arial, sans-serif",
    "secondary": "Pretendard, Inter, Arial, sans-serif",
    "mono": "Roboto Mono, JetBrains Mono, Geist Mono, monospace",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "typeScale": {
    "caption": {
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.2,
      "letterSpacing": "0"
    },
    "bodySm": {
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.43,
      "letterSpacing": "0"
    },
    "body": {
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.63,
      "letterSpacing": "0"
    },
    "subheading": {
      "fontSize": "20px",
      "fontWeight": 400,
      "lineHeight": 1.4,
      "letterSpacing": "-0.16px"
    },
    "headingSm": {
      "fontSize": "22px",
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": "-0.2px"
    },
    "heading": {
      "fontSize": "40px",
      "fontWeight": 600,
      "lineHeight": 1.05,
      "letterSpacing": "-1.48px"
    },
    "headingLg": {
      "fontSize": "56px",
      "fontWeight": 600,
      "lineHeight": 1.05,
      "letterSpacing": "-1.51px"
    },
    "display": {
      "fontSize": "80px",
      "fontWeight": 600,
      "lineHeight": 1.05,
      "letterSpacing": "-1.52px"
    }
  },
  "spacing": {
    "density": "compact",
    "4": "4px",
    "6": "6px",
    "8": "8px",
    "9": "9px",
    "10": "10px",
    "11": "11px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "36": "36px",
    "40": "40px",
    "52": "52px",
    "72": "72px",
    "maxWidth": "1200px",
    "sectionGap": "80px",
    "cardPadding": "12px",
    "elementGap": "8px to 12px"
  },
  "radius": {
    "minimum": "4px",
    "innerCard": "8px",
    "input": "12px",
    "pipelineCard": "16px",
    "container": "16px to 40px",
    "glass": "28px to 48px",
    "pill": "9999px"
  },
  "shadows": {
    "smallCard": "rgba(0, 0, 0, 0.1) 0px 0px 4px -2px",
    "featureCard": "rgba(0, 0, 0, 0.082) 0px 0.36px 1.8px -1.4px, rgba(0, 0, 0, 0.07) 0px 1.37px 6.87px -2.8px, rgba(0, 0, 0, 0.016) 0px 6px 30px -4.25px",
    "blueGlow": "rgba(20, 90, 255, 0.1) 0px 0px 100px -28px"
  },
  "motion": {
    "easing": "ease",
    "properties": ["color", "opacity", "box-shadow", "border-color"],
    "avoid": ["spring", "bounce", "parallax", "entrance choreography"]
  }
}


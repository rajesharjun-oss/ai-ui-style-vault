{
  "name": "Superhuman",
  "slug": "superhuman",
  "sourceUrl": "https://styles.refero.design/style/418b374a-be64-44f0-b17e-1d45308c7e62",
  "referenceSite": "https://superhuman.com",
  "theme": "light",
  "colors": {
    "midnight-wine": "#421d24",
    "royal-violet": "#714cb6",
    "lilac-mist": "#d4c7ff",
    "deep-lagoon": "#0c4243",
    "ink-charcoal": "#292827",
    "stone-gray": "#666666",
    "soft-mist": "#e3e3e2",
    "warm-parchment": "#f2f0eb",
    "paper-white": "#ffffff"
  },
  "typography": {
    "fontFamily": {
      "sans": "\"Super Sans VF\", \"Inter\", \"Sohne\", \"General Sans\", Arial, sans-serif"
    },
    "fontWeight": {
      "light-cut": 460,
      "regular": 500,
      "emphasis": 540,
      "semibold": 600,
      "label-bold": 700
    },
    "fontSize": {
      "caption": "12px",
      "body-sm": "14px",
      "body": "16px",
      "label-bold": "19px",
      "subheading": "26px",
      "heading-sm": "28px",
      "heading-lg": "49px",
      "display": "64px"
    },
    "lineHeight": {
      "caption": "1.5",
      "body-sm": "1.5",
      "body": "1.2",
      "label-bold": "1.5",
      "subheading": "1.3",
      "heading-sm": "1.14",
      "heading-lg": "1.2",
      "display": "0.96"
    },
    "letterSpacing": {
      "heading-sm": "-0.62px",
      "heading-lg": "-1.32px",
      "display": "-1.8px",
      "display-em": "-0.028em",
      "body": "0"
    },
    "openType": "\"ss01\" on if supported; tabular numerals for UI cards"
  },
  "spacing": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "36": "36px",
    "40": "40px",
    "48": "48px",
    "64": "64px",
    "80": "80px",
    "96": "96px"
  },
  "layout": {
    "maxWidth": "1200px",
    "sectionGap": "64px to 96px",
    "cardPadding": "16px",
    "elementGap": "8px"
  },
  "radius": {
    "tabs": "8px",
    "small-buttons": "8px",
    "cards": "16px",
    "buttons": "16px",
    "floating-cards": "16px",
    "pills": "999px"
  },
  "elevation": {
    "shadow": "none",
    "subtle-inset": "rgb(113, 76, 182) 0px 0px 0px 1px inset",
    "header-blur": "backdrop-filter: blur(12px)"
  },
  "components": {
    "primary-action-button": {
      "background": "{colors.midnight-wine}",
      "text": "{colors.paper-white}",
      "radius": "{radius.buttons}",
      "height": "48px",
      "shadow": "none"
    },
    "floating-product-card": {
      "background": "rgba(255, 255, 255, 0.85)",
      "border": "1px solid rgba(255, 255, 255, 0.2)",
      "radius": "{radius.floating-cards}",
      "padding": "16px",
      "shadow": "none"
    },
    "suite-product-card": {
      "background": "{colors.paper-white}",
      "radius": "{radius.cards}",
      "padding": "16px",
      "linkColor": "{colors.royal-violet}",
      "shadow": "none"
    },
    "footer": {
      "background": "{colors.midnight-wine}",
      "text": "{colors.paper-white}",
      "paddingY": "64px"
    }
  }
}

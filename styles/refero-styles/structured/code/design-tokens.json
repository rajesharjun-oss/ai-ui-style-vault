    "guidelines":  {
                       "do":  [
                                  "Use Davinci-style serif at 52px and above for display moments.",
                                  "Make the 374px wordmark feel larger than the screen.",
                                  "Alternate Putty and Ink full-bleed sections.",
                                  "Use circular crops for feature imagery.",
                                  "Use black pill CTAs with compact 9px 17px padding.",
                                  "Use hexagonal indicators as the secondary geometry."

{
  "name": "AI UI Style Vault Prompt Index",
  "version": "1.3.0",
  "canonicalInstructions": "AGENTS.md",
  "humanRouter": "PROMPTS.md",
  "domainPackRouter": "PACKS.md",
  "domainPackIndex": "packs/pack-index.json",
  "platformAdapters": {
    "codex": "AGENTS.md",
    "claudeCode": "CLAUDE.md",
    "geminiCli": "GEMINI.md"
  },
  "routingRule": "The most specific product prompt wins; capability prompts such as 3D may be added alongside it.",
  "prompts": [
    {
      "id": "senior-product-team",
      "path": "prompts/SENIOR_PRODUCT_TEAM_PROMPT.md",
      "priority": 10,
      "requiredFor": [
        "all product interface builds"
      ],
      "triggers": [
        "website",
        "web app",
        "dashboard",
        "application",
        "interface",
        "ui"
      ]
    },
    {
      "id": "build-premium-business-website",
      "path": "prompts/BUILD_PREMIUM_BUSINESS_WEBSITE.md",
      "priority": 40,
      "requiredFor": [
        "new website for a real business"
      ],
      "triggers": [
        "build a website for this business",
        "maps link",
        "business link",
        "company website",
        "restaurant website",
        "professional services website",
        "local business website"
      ],
      "followedBy": [
        "visual-qa-and-revision"
      ]
    },
    {
      "id": "build-celebration-event-microsite",
      "path": "prompts/BUILD_CELEBRATION_EVENT_MICROSITE.md",
      "priority": 110,
      "requiredFor": [
        "wedding or Nikkah website",
        "engagement or anniversary website",
        "save-the-date or invitation microsite",
        "couple story and event details",
        "guest RSVP and private event access",
        "post-event thank-you or gallery"
      ],
      "triggers": [
        "wedding website",
        "nikkah website",
        "engagement website",
        "anniversary website",
        "couple website",
        "save the date",
        "wedding invitation",
        "event microsite",
        "rsvp website",
        "relationship story",
        "wedding gallery",
        "gift registry",
        "private celebration",
        "post event gallery"
      ],
      "requiresDomainPack": "celebration-event-microsite",
      "optionalPrompts": [
        "build-premium-business-website"
      ],
      "followedBy": [
        "visual-qa-and-revision"
      ]
    },
    {
      "id": "build-restaurant-commerce-experience",
      "path": "prompts/BUILD_RESTAURANT_COMMERCE_EXPERIENCE.md",
      "priority": 100,
      "requiredFor": [
        "restaurant ordering",
        "food delivery",
        "pickup and takeaway",
        "quick-service or fast-casual commerce",
        "cafe or bakery ordering",
        "multi-branch food commerce"
      ],
      "triggers": [
        "restaurant",
        "food ordering",
        "online menu",
        "menu catalog",
        "takeaway",
        "pickup",
        "food delivery",
        "quick service restaurant",
        "fast casual",
        "pizza ordering",
        "cafe ordering",
        "bakery ordering",
        "cart",
        "checkout",
        "loyalty",
        "order tracking"
      ],
      "requiresPrompts": [
        "build-premium-business-website"
      ],
      "requiresDomainPack": "fast-casual-commerce",
      "followedBy": [
        "visual-qa-and-revision"
      ]
    },
    {
      "id": "refine-existing-business-website",
      "path": "prompts/REFINE_EXISTING_BUSINESS_WEBSITE.md",
      "priority": 60,
      "requiredFor": [
        "redesign or improvement of an existing business or event site"
      ],
      "triggers": [
        "redesign",
        "improve this website",
        "make it premium",
        "refine the site",
        "fix the design",
        "modernise",
        "screenshots"
      ],
      "followedBy": [
        "visual-qa-and-revision"
      ]
    },
    {
      "id": "visual-qa-and-revision",
      "path": "prompts/VISUAL_QA_AND_REVISION.md",
      "priority": 90,
      "requiredFor": [
        "all browser-rendered builds after the first render"
      ],
      "triggers": [
        "localhost",
        "preview",
        "browser render",
        "screenshot",
        "visual qa",
        "before handoff"
      ]
    },
    {
      "id": "build-3d-immersive-web-experience",
      "path": "prompts/BUILD_3D_IMMERSIVE_WEB_EXPERIENCE.md",
      "priority": 120,
      "requiredFor": [
        "3D or immersive website",
        "WebGL/WebGPU",
        "product configurator",
        "digital twin",
        "AR/WebXR"
      ],
      "triggers": [
        "3d website",
        "immersive website",
        "webgl",
        "webgpu",
        "three.js",
        "react three fiber",
        "r3f",
        "babylon.js",
        "spline",
        "3d configurator",
        "virtual showroom",
        "digital twin",
        "webxr"
      ],
      "requiresCapabilityPack": "3d-immersive-web",
      "combineWithMatchingProductDomainPack": true,
      "followedBy": [
        "visual-qa-and-revision"
      ]
    }
  ],
  "requiredPlanningArtifactsForBusinessBuilds": [
    "BUSINESS_RESEARCH.md",
    "ASSET_PLAN.md",
    "VAULT_SELECTION.md",
    "BUILD_CONTRACT.md",
    "CONTENT_PLAN.md",
    "design-recipe.json"
  ],
  "additionalPlanningArtifactsByDomainPack": {
    "fast-casual-commerce": [
      "COMMERCE_BUILD_CONTRACT.md"
    ],
    "celebration-event-microsite": [
      "EVENT_BUILD_CONTRACT.md",
      "COUPLE_CONTENT_PLAN.md",
      "ASSET_PLAN.md"
    ],
    "3d-immersive-web": [
      "THREE_D_RELEVANCE_CONTRACT.md",
      "THREE_D_BUILD_CONTRACT.md",
      "SCENE_ASSET_PLAN.md",
      "PERFORMANCE_AND_FALLBACK_PLAN.md"
    ]
  },
  "handoffRequirements": [
    "verified facts and provisional assumptions",
    "rendered desktop and mobile screenshots",
    "asset provenance, consent and licence notes",
    "commands and checks run",
    "truthful localhost or deployment instructions",
    "integrated versus prototype-only capabilities",
    "privacy and data-retention plan when personal data is present",
    "remaining risks and owner-confirmation items"
  ]
}

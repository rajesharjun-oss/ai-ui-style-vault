{
  "name": "AI UI Style Vault Prompt Index",
  "version": "1.1.0",
  "canonicalInstructions": "AGENTS.md",
  "humanRouter": "PROMPTS.md",
  "domainPackRouter": "PACKS.md",
  "domainPackIndex": "packs/pack-index.json",
  "platformAdapters": {
    "codex": "AGENTS.md",
    "claudeCode": "CLAUDE.md",
    "geminiCli": "GEMINI.md"
  },
  "routingRule": "The most specific matching prompt wins and may require one or more general prompts plus a domain pack.",
  "prompts": [
    {
      "id": "senior-product-team",
      "path": "prompts/SENIOR_PRODUCT_TEAM_PROMPT.md",
      "priority": 10,
      "requiredFor": ["all product interface builds"],
      "triggers": ["website", "web app", "dashboard", "application", "interface", "ui"]
    },
    {
      "id": "build-premium-business-website",
      "path": "prompts/BUILD_PREMIUM_BUSINESS_WEBSITE.md",
      "priority": 40,
      "requiredFor": ["new website for a real business"],
      "triggers": [
        "build a website for this business",
        "maps link",
        "business link",
        "company website",
        "restaurant website",
        "professional services website",
        "local business website"
      ],
      "followedBy": ["visual-qa-and-revision"]
    },
    {
      "id": "build-restaurant-commerce-experience",
      "path": "prompts/BUILD_RESTAURANT_COMMERCE_EXPERIENCE.md",
      "priority": 100,
      "requiredFor": [
        "restaurant ordering",
        "food delivery",
        "pickup and takeaway",
        "quick-service or fast-casual commerce",
        "cafe or bakery ordering",
        "multi-branch food commerce"
      ],
      "triggers": [
        "restaurant",
        "food ordering",
        "online menu",
        "menu catalog",
        "takeaway",
        "pickup",
        "food delivery",
        "quick service restaurant",
        "fast casual",
        "pizza ordering",
        "cafe ordering",
        "bakery ordering",
        "cart",
        "checkout",
        "loyalty",
        "order tracking"
      ],
      "requiresPrompts": ["build-premium-business-website"],
      "requiresDomainPack": "fast-casual-commerce",
      "followedBy": ["visual-qa-and-revision"]
    },
    {
      "id": "refine-existing-business-website",
      "path": "prompts/REFINE_EXISTING_BUSINESS_WEBSITE.md",
      "priority": 60,
      "requiredFor": ["redesign or improvement of an existing business site"],
      "triggers": [
        "redesign",
        "improve this website",
        "make it premium",
        "refine the site",
        "fix the design",
        "modernise",
        "screenshots"
      ],
      "followedBy": ["visual-qa-and-revision"]
    },
    {
      "id": "visual-qa-and-revision",
      "path": "prompts/VISUAL_QA_AND_REVISION.md",
      "priority": 90,
      "requiredFor": ["all browser-rendered builds after the first render"],
      "triggers": ["localhost", "preview", "browser render", "screenshot", "visual qa", "before handoff"]
    }
  ],
  "requiredPlanningArtifactsForBusinessBuilds": [
    "BUSINESS_RESEARCH.md",
    "ASSET_PLAN.md",
    "VAULT_SELECTION.md",
    "BUILD_CONTRACT.md",
    "CONTENT_PLAN.md",
    "design-recipe.json"
  ],
  "additionalPlanningArtifactsByDomainPack": {
    "fast-casual-commerce": ["COMMERCE_BUILD_CONTRACT.md"]
  },
  "handoffRequirements": [
    "verified business facts and provisional assumptions",
    "rendered desktop and mobile screenshots",
    "asset provenance and licence notes",
    "commands and checks run",
    "truthful localhost or deployment instructions",
    "integrated versus prototype-only capabilities",
    "remaining risks and owner-confirmation items"
  ]
}
